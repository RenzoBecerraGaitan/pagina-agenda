rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función para validar si el correo del usuario es Administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.toLowerCase() == "renzobecerragaitan@gmail.com" ||
        request.auth.token.email.toLowerCase() == "cerezoli387@gmail.com" // 
      );
    }

    // Reglas para la colección 'eventos'
    match /eventos/{eventoId} {
      // 1. Lectura pública (cualquier visitante ve la web)
      allow read: if true;

      // 2. Creación permitida a cualquier usuario logueado con Google
      allow create: if request.auth != null;

      // 3. Edición, aprobación y borrado PERMITIDO ÚNICAMENTE a los dos emails anteriores
      allow update, delete: if isAdmin();
    }
  }
}